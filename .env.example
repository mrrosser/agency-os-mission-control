# Firebase Admin / Application Default Credentials are required by the app.
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Rosser Gallery -> Mission Control service-to-service CRM ingest.
# Generate both secrets independently; each must contain at least 32 characters.
CRM_INGEST_TOKEN=
ROSSER_GALLERY_CRM_CUSTOMER_ID_HMAC_SECRET=

# Server-owned routing. The sender cannot override these values.
ROSSER_GALLERY_CRM_OWNER_UID=
ROSSER_GALLERY_CRM_WORKSPACE_ID=
ROSSER_GALLERY_CRM_BUSINESS_UNIT=rosser_nft_gallery

# Keep disabled locally unless telemetry storage is intentionally configured.
TELEMETRY_SERVER_ERRORS=false
