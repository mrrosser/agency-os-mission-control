# Server-side settings only. Defaults are intentionally off.
CRM_ASSISTANT_ENABLED=false
CRM_ASSISTANT_VOICE_ENABLED=false
OPENAI_CRM_MODEL=gpt-4.1-mini
OPENAI_CRM_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_CRM_VOICE=marin
# Store owner openaiKey in the existing secure vault, or bind server OPENAI_API_KEY
# using Secret Manager. No secret value belongs in this file or NEXT_PUBLIC_*.
